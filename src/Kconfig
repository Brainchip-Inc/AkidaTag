config WDT_ENABLE
    bool "Enable watchdog"
    default n
    help
      Enables the application watchdog (WDT).
      When enabled, the watchdog will be initialized during system
      startup and periodically fed by the application threads.
      When disabled, watchdog initialization and feeding will be
      skipped.
config APP_WDT_TIMEOUT_MS
    int "Application watchdog timeout in milliseconds"
    default 8000
    help
      Watchdog timeout value used by the application.

config CAMERA_ENABLE_THREAD
    bool "Enable dedicated camera processing thread"
    default y
    help
      Enables a separate thread for camera frame processing.


