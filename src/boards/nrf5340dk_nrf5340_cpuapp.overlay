&qspi {
    status = "disabled";
};
/* Disable default LEDs */
&led0 {
    status = "disabled";
};

&led1 {
    status = "disabled";
};

&led2 {
    status = "disabled";
};

&led3 {
    status = "disabled";
};

/* Disable default buttons */
&button0 {
    status = "disabled";
};

&button1 {
    status = "disabled";
};

&button2 {
    status = "disabled";
};

&button3 {
    status = "disabled";
};
&gpio_fwd {
    status = "disabled";
};

&pwm0 {
    status = "disabled";
};

/* Disable the entire gpio-keys and leds nodes if needed */
/ {
    buttons {
        status = "disabled";
    };
    
    leds {
        status = "disabled";
    };
};
&pinctrl {
    /* SPIM2 now drives the nRF storage flash (relocated off SPIM4 so the Akida
     * can take SPIM4). Same physical flash pins P0.17/13/14; standard drive and
     * <=8 MHz are plenty for littlefs storage. */
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 14)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 13)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 14)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 13)>;
            low-power-enable;
        };
    };

	uart0_default_alt: uart0_default_alt {
      group1 {
         psels = <NRF_PSEL(UART_TX, 0, 29)>,
                 <NRF_PSEL(UART_RX, 1, 4)>;
      };
   };

   uart0_sleep_alt: uart0_sleep_alt {
      group1 {
         psels = <NRF_PSEL(UART_TX, 0, 29)>,
                 <NRF_PSEL(UART_RX, 1, 4)>;
         low-power-enable;
      };
   };	

   pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 9)>,
				    <NRF_PSEL(PDM_DIN, 1, 10)>;
		};
	};

    /omit-if-no-ref/ i2c1_default: i2c1_default {
		group1  {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
					<NRF_PSEL(TWIM_SDA, 1, 2)>;
		};
	};

	/omit-if-no-ref/ i2c1_sleep: i2c1_sleep {
		group1  {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
					<NRF_PSEL(TWIM_SDA, 1, 2)>;
			low-power-enable;
		};
	};
/* Use alternate SPI pins for camera on nRF5340 DK because P0.17/P0.13/P0.14 are occupied by onboard external flash */
    spi3_default: spi3_default {
		group1 {
				psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                        <NRF_PSEL(SPIM_MISO, 0, 6)>,
                        <NRF_PSEL(SPIM_MOSI, 0, 7)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
				psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                        <NRF_PSEL(SPIM_MISO, 0, 6)>,
                        <NRF_PSEL(SPIM_MOSI, 0, 7)>;
				low-power-enable;
		};
	};
    /* Akida host SPI on SPIM4 (only nRF5340 instance that does >8 MHz).
     * P0.08=SCK, P0.09=MOSI, P0.10=MISO (MISO jumper moved P1.08 -> P0.10 for
     * SPIM4). HIGH DRIVE (H0H1) for clean SCK/MOSI edges at 16/32 MHz. */
    spi4_default: spi4_default {
		group1 {
				psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
						<NRF_PSEL(SPIM_MISO, 0, 10)>,
						<NRF_PSEL(SPIM_MOSI, 0, 9)>;
				nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	spi4_sleep: spi4_sleep {
		group1 {
				psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
						<NRF_PSEL(SPIM_MISO, 0, 10)>,
						<NRF_PSEL(SPIM_MOSI, 0, 9)>;
				low-power-enable;
		};
	};
	
};

/* PDM mic configurations */

&clock {
	hfclkaudio-frequency = <12288000>;
};

&pdm0 {
	status = "okay";
	clock-source = "ACLK";
};

dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
	clock-source = "ACLK";
   
};
/ {
    chosen {
        nordic,pm-ext-flash = &ext_flash;
    };
};

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;   // 400 kHz
    pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    mysensor: mysensor@6a{
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x6a >;
    };
};


&ipc0 {
    status = "okay";
};


/* SPIM2 now hosts the nRF storage flash (moved here from SPIM4). */
&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;  /* CS for nRF storage flash */

    /* nRF storage flash (littlefs) at index 0 */
    ext_flash: flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <8000000>;
        label = "SPI_FLASH";
        size = <DT_SIZE_M(64)>;
        jedec-id = [c2 28 17];
    };
};

&uart0 {
   status = "okay";
   compatible = "nordic,nrf-uarte";
   current-speed = <115200>;
   pinctrl-0 = <&uart0_default_alt>;
   pinctrl-1 = <&uart0_sleep_alt>;
   pinctrl-names = "default", "sleep";
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>; /*CS for camera*/
    /* camera device at index 0 */
    camera: camera@0 {
        compatible = "spi-device";
        reg = <0>;  /* Uses first CS pin (P0.25) */
        spi-max-frequency = <16000000>;
        label = "CAMERA";
    };
};
/* Akida moved onto SPIM4 (up to 32 MHz). Same akida bus, CS P0.11/P0.12. The
 * host clock is bounded by the AKD1500 SPI_S core clock (¼-rule, §3.7.1): needs
 * the SPI_S core on the 400 MHz PLL (akd_core_clock_to_pll, done at boot), else
 * it caps ~3-6 MHz on the reference/bypass clock. */
&spi4 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi4_default>;
    pinctrl-1 = <&spi4_sleep>;
    pinctrl-names = "default", "sleep";
    /* rx-delay=2 (MISO sample delay). The DK's long jumper wires add round-trip
     * delay vs the AkidaTag PCB, so the sampling eye sits later: HW-swept, 16 & 32
     * MHz read cleanly (0/500) at rxd 2-3 (AkidaTag used 1). NOTE: 4 & 8 MHz show
     * intermittent first-byte errors on the DK jumper wiring that no rxd fixes —
     * a DK signal-integrity artifact, not a chip limit. Use 16/32 MHz on the DK. */
    rx-delay = <2>;
    cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>,  /* CS for AKIDA */
               <&gpio0 12 GPIO_ACTIVE_LOW>;  /* CS for AKIDA flash (S2M) */

    akd: akd@0 {
        compatible = "spi-device";
        reg = <0>;  /* Uses first CS pin (P0.11) */
        spi-max-frequency = <32000000>;
        label = "AKD";
    };

    /* W25Q128 flash accessed by the AKD1500 (S2M) */
    akd_flash: akd_flash@1 {
        compatible = "spi-device";  /* manual control */
        reg = <1>;  /* Uses second CS pin (P0.12) */
        spi-max-frequency = <8000000>;
        label = "AKD_FLASH";
    };
};
/ {
    aliases {
        watchdog = &wdt;
    };
};

/ {
    gpios {
		compatible = "gpio-keys";
		akdsleep: akdsleep {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
		};

        akdreset: akdreset {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		};
	
        imui: imui {
			gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
		};		
		
	};

    leds {
        compatible = "gpio-leds";

        led_red: led_red {
            gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
        };

        led_green: led_green {
            gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        akdsleep = &akdsleep;
        akdreset = &akdreset;
        spi2 = &spi2;
        akd-spi = &spi4;   /* Akida SPI bus: SPIM4 (up to 32 MHz); storage flash moved to SPIM2 */
        imui = &imui;
    };
};