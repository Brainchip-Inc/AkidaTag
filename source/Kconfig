source "Kconfig.zephyr"

menu "Nordic LED-Button BLE GATT service sample"

config BT_LBS_SECURITY_ENABLED
	bool "Enable security"
	default y
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select NVS
	select SETTINGS
	help
	  "Enable BLE security for the LED-Button service"

config DK_BOARD
    bool "Enable DK Board specific initialization"
    depends on BT
    help
      This enables the DK Board specific initialization.

config SAMPLING_RATE
    int "Sampling Rate"
    default 16000
    help
      Sampling Rate.
      
config DEMO_APPS
    bool "Enable Feature KWS, Gyro"
    default n

config FEAT_B
    bool "Enable Feature B"
    default n

config FEAT_C
    bool "Enable Feature C"
    default n

config FEAT_D
    bool "Enable Feature D"
    default n




endmenu
