source "Kconfig.zephyr"

menu "Akida Tag Application"

config SRAM_BUFFER_SIZE
    int "Allocate SRAM for BLE or raw audio sample capture"
    default 102400
    help
      Allocate SRAM for app use.
	  
config BATCH_SIZE
    int "Batch size"
    default 4
    help
      Batch size.	  
	  
config MFCC_METHOD
    int "MFCC computation method"
    default 1
    help
      MFCC computation method.

config AUDIO_CAPTURE_TEST
    bool "Raw Audio Capture Test"
    default n
    help
      Raw Audio Capture Test.

config MFCC_SAMPLE_COUNT
    int "MFCC sample count"
    default 320
    help
      Number of PCM samples used per MFCC frame.

config CHANNELS_PER_SAMPLE
    int "no of channel per sample"
    default 2
    help
      Number of channel used.
	
config SAMPLING_RATE
    int "Sampling Rate"
    default 16000
    help
      Sampling Rate.
	  
config AUDIO
    bool "Enable AUDIO"
    default n
    help
      This enables AUDIO.
	  
config AUDIO_DMIC
    bool "Enable DMIC"
    default n
    help
      This enables DMIC.

config AUDIO_BLOCK_MS
    int "Audio DMA block size (ms)"
    default 60
    help
      Default PDM capture block size in milliseconds. Must be a multiple of the
      MFCC hop (CONFIG_MFCC_SAMPLE_COUNT samples = 20 ms at 16 kHz) so MFCC
      framing stays aligned, and no larger than CONFIG_AUDIO_MAX_BLOCK_MS.
      Runtime-adjustable via the `app blkms` shell command. Smaller = lower
      latency but a faster capture cadence.

config AUDIO_MAX_BLOCK_MS
    int "Maximum audio DMA block size (ms)"
    default 80
    help
      Upper bound for the audio block size. The DMA mem-slab and the audio
      processing buffers are statically sized for this value, so a runtime
      `app blkms` change can never overrun them. Must be a multiple of 20.

config SYNC_MODE
    int "Enable Akida Sync"
    default 0
    help
      This enables Akida Sync.	  
	  
config BT_LBS_SECURITY_ENABLED
	bool "Enable security"
	default n
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select NVS
	select SETTINGS
	help
	  "Enable BLE security for the LED-Button service"

config DK_BOARD
    bool "Enable DK Board specific initialization"
    depends on BT
    help
      This enables the DK Board specific initialization.
config SPARK_BOARD
    bool "Enable spark Board specific initialization"
    help
      This enables the spark Board specific initialization.

config SYS_CPU_128MHZ
    bool "Run the nRF5340 application core at 128 MHz"
    default y if SPARK_BOARD
    help
      Raise the application-core HCLK divider to DIV1 so the CPU runs at its
      maximum 128 MHz instead of the 64 MHz reset default. Increases core
      dynamic power by roughly 2x. Only the CPU domain is affected; peripheral
      and system-timer clocks are unchanged.

config CURRENT_DEFAULT_RATE_HZ
    int "Default INA190 current-sense sampler rate (Hz)"
    default 100
    depends on SPARK_BOARD
    help
      Default rate of the background current/power/energy sampler.
      Runtime-adjustable via the `power rate` shell command.

config AKD_SPI_FREQ_HZ
    int "AKD1500 host SPI clock (Hz)"
    default 4000000 if SPARK_BOARD
    default 1400000
    help
      Boot-time nRF5340 -> AKD1500 SPI clock, applied once the device is
      confirmed alive during bring-up. Spark defaults to 4 MHz: HW testing found
      AKD1500 model programming (the DMA-config handshake) reliably works up to
      4 MHz but times out at the 8 MHz SPIM2 step, even though plain reads/SRAM
      tolerate 8 MHz. The nRF SPIM rounds down to discrete steps (1/2/4/8 MHz on
      SPIM2). Use the `spi_freq` shell command to re-characterise on your board.
      DK keeps the conservative 1.4 MHz default.

config SAMPLING_RATE
    int "Sampling Rate"
    default 16000
    help
      Sampling Rate.
      
config DEMO_APPS
    bool "Enable Feature KWS, Gyro"
    default n

config FEAT_B
    bool "Enable Feature B"
    default n

config FEAT_C
    bool "Enable Feature C"
    default n

config FEAT_D
    bool "Enable Feature D"
    default n

config IMU_USE_INTERRUPT
	bool "Use IMU interrupt mode"
	default y
	help
	  Enable interrupt-driven IMU data acquisition.
	  Disable to use polling mode.

config IMU_ACC_ODR
	int "Accelerometer ODR"
	default 5
	help
	  0=OFF, 1=12.5Hz, 2=26Hz, 3=52Hz, 4=104Hz,
	  5=208Hz, 6=416Hz, 7=833Hz, 8=1660Hz

config IMU_ACC_FS
	int "Accelerometer Full Scale"
	default 3
	help
	  0=±2g, 1=±16g, 2=±4g, 3=±8g

config IMU_GYRO_ODR
	int "Gyroscope ODR"
	default 5
	help
	  Same encoding as accel ODR

config IMU_GYRO_FS
	int "Gyroscope Full Scale"
	default 1
	help
	  0=250dps, 1=500dps, 2=1000dps, 3=2000dps

config IMU_FIFO_ACC_ODR
	int "FIFO Accel Batch Data Rate"
	default 5
	help
	  Same encoding as ODR

config IMU_FIFO_GYRO_ODR
	int "FIFO Gyro Batch Data Rate"
	default 5
	help
	  Same encoding as ODR

config IMU_ENABLE_THREAD
    bool "Enable IMU processing thread"
    default y
    help
      Enables creation of the IMU processing thread.
      When disabled, no IMU thread or stack is created.

config IMU_FIFO_WATERMARK
    int "IMU FIFO Watermark Level"
    default 32
    help
      FIFO watermark level (number of FIFO entries before interrupt).
      Allowed values: 8, 16, 32
config WDT_ENABLE
    bool "Enable watchdog"
    default n
    help
      Enables the application watchdog (WDT).
      When enabled, the watchdog will be initialized during system
      startup and periodically fed by the application threads.
      When disabled, watchdog initialization and feeding will be
      skipped.
config APP_WDT_TIMEOUT_MS
    int "Application watchdog timeout in milliseconds"
    default 8000
    help
      Watchdog timeout value used by the application.

config CAMERA_ENABLE_THREAD
    bool "Enable dedicated camera processing thread"
    default y
    help
      Enables a separate thread for camera frame processing.


endmenu
