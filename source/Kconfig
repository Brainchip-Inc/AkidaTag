source "Kconfig.zephyr"

menu "Akida Tag Application"

config SRAM_BUFFER_SIZE
    int "Allocate SRAM for BLE or raw audio sample capture"
    default 102400
    help
      Allocate SRAM for app use.
	  
config BATCH_SIZE
    int "Batch size"
    default 4
    help
      Batch size.	  
	  
config MFCC_METHOD
    int "MFCC computation method"
    default 1
    help
      MFCC computation method.

config AUDIO_CAPTURE_TEST
    bool "Raw Audio Capture Test"
    default n
    help
      Raw Audio Capture Test.

config MFCC_SAMPLE_COUNT
    int "MFCC sample count"
    default 320
    help
      Number of PCM samples used per MFCC frame.

config CHANNELS_PER_SAMPLE
    int "no of channel per sample"
    default 2
    help
      Number of channel used.
	
config SAMPLING_RATE
    int "Sampling Rate"
    default 16000
    help
      Sampling Rate.
	  
config AUDIO
    bool "Enable AUDIO"
    default n
    help
      This enables AUDIO.
	  
config AUDIO_DMIC
    bool "Enable DMIC"
    default n
    help
      This enables DMIC.

config SYNC_MODE
    int "Enable Akida Sync"
    default 0
    help
      This enables Akida Sync.	  
	  
config BT_LBS_SECURITY_ENABLED
	bool "Enable security"
	default n
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select NVS
	select SETTINGS
	help
	  "Enable BLE security for the LED-Button service"

config DK_BOARD
    bool "Enable DK Board specific initialization"
    depends on BT
    help
      This enables the DK Board specific initialization.

config SAMPLING_RATE
    int "Sampling Rate"
    default 16000
    help
      Sampling Rate.
      
config DEMO_APPS
    bool "Enable Feature KWS, Gyro"
    default n

config FEAT_B
    bool "Enable Feature B"
    default n

config FEAT_C
    bool "Enable Feature C"
    default n

config FEAT_D
    bool "Enable Feature D"
    default n

config IMU_USE_INTERRUPT
	bool "Use IMU interrupt mode"
	default y
	help
	  Enable interrupt-driven IMU data acquisition.
	  Disable to use polling mode.

config IMU_ACC_ODR
	int "Accelerometer ODR"
	default 5
	help
	  0=OFF, 1=12.5Hz, 2=26Hz, 3=52Hz, 4=104Hz,
	  5=208Hz, 6=416Hz, 7=833Hz, 8=1660Hz

config IMU_ACC_FS
	int "Accelerometer Full Scale"
	default 3
	help
	  0=±2g, 1=±16g, 2=±4g, 3=±8g

config IMU_GYRO_ODR
	int "Gyroscope ODR"
	default 5
	help
	  Same encoding as accel ODR

config IMU_GYRO_FS
	int "Gyroscope Full Scale"
	default 1
	help
	  0=250dps, 1=500dps, 2=1000dps, 3=2000dps

config IMU_FIFO_ACC_ODR
	int "FIFO Accel Batch Data Rate"
	default 5
	help
	  Same encoding as ODR

config IMU_FIFO_GYRO_ODR
	int "FIFO Gyro Batch Data Rate"
	default 5
	help
	  Same encoding as ODR

config IMU_ENABLE_THREAD
    bool "Enable IMU processing thread"
    default y
    help
      Enables creation of the IMU processing thread.
      When disabled, no IMU thread or stack is created.

config IMU_FIFO_WATERMARK
    int "IMU FIFO Watermark Level"
    default 32
    help
      FIFO watermark level (number of FIFO entries before interrupt).
      Allowed values: 8, 16, 32
config WDT_ENABLE
    bool "Enable watchdog"
    default n
    help
      Enables the application watchdog (WDT).
      When enabled, the watchdog will be initialized during system
      startup and periodically fed by the application threads.
      When disabled, watchdog initialization and feeding will be
      skipped.
config APP_WDT_TIMEOUT_MS
    int "Application watchdog timeout in milliseconds"
    default 8000
    help
      Watchdog timeout value used by the application.

config CAMERA_ENABLE_THREAD
    bool "Enable dedicated camera processing thread"
    default y
    help
      Enables a separate thread for camera frame processing.


endmenu
