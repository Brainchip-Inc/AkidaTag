&led0 {
    status = "disabled";
};

&led1 {
    status = "disabled";
};

&led2 {
    status = "disabled";
};

&led3 {
    status = "disabled";
};
&pwm0 {
    status = "disabled";
};

/ {
    
    leds {
        status = "disabled";
    };
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
                    <NRF_PSEL(SPIM_MISO, 1, 10)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 9)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
                    <NRF_PSEL(SPIM_MISO, 1, 10)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 9)>;
            low-power-enable;
        };
    };
	uart0_default_alt: uart0_default_alt {
      group1 {
         psels = <NRF_PSEL(UART_TX, 0, 6)>,
                 <NRF_PSEL(UART_RX, 0, 5)>;
      };
   };

   uart0_sleep_alt: uart0_sleep_alt {
      group1 {
         psels = <NRF_PSEL(UART_TX, 0, 6)>,
                 <NRF_PSEL(UART_RX, 0, 5)>;
         low-power-enable;
      };
   };	

   pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 0, 26)>,
				<NRF_PSEL(PDM_DIN, 0, 25)>;
		};
	};

    /omit-if-no-ref/ i2c1_default: i2c1_default {
		group1  {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
					<NRF_PSEL(TWIM_SDA, 1, 2)>;
		};
	};

	/omit-if-no-ref/ i2c1_sleep: i2c1_sleep {
		group1  {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
					<NRF_PSEL(TWIM_SDA, 1, 2)>;
			low-power-enable;
		};
	};
	
};

/* PDM mic configurations */

&clock {
	hfclkaudio-frequency = <12288000>;
};

&pdm0 {
	status = "okay";
	clock-source = "ACLK";
};

dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
	clock-source = "ACLK";
   
};

/* STEP 2.1 - Add external flash to application */
&mx25r64 {
	status = "okay";
};

/ {
	chosen {
		nordic,pm-ext-flash = &mx25r64;
	};
};


&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;   // 400 kHz
    pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    mysensor: mysensor@6a{
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x6a >;
    };
};


&ipc0 {
    status = "okay";
};


&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>,  /* CS for AKIDA */
               <&gpio0 12 GPIO_ACTIVE_LOW>;  /* CS for AKIDA flash */

    /* camera device at index 0 */
    akd: akd@0 {
        compatible = "spi-device";
        reg = <0>;  /* Uses first CS pin (P0.11) */
        spi-max-frequency = <8000000>;
        label = "AKD";
    };

    /* W25Q128 Flash device at index 1 */
    akd_flash: akd_flash@1 {
        compatible = "spi-device";  /* Use spi-device for manual control */
        reg = <1>;  /* Uses second CS pin (P0.12) */
        spi-max-frequency = <8000000>;
        label = "AKD_FLASH";
    };
};

&uart0 {
   status = "okay";
   compatible = "nordic,nrf-uarte";
   current-speed = <115200>;
   pinctrl-0 = <&uart0_default_alt>;
   pinctrl-1 = <&uart0_sleep_alt>;
   pinctrl-names = "default", "sleep";
};

/ {
    aliases {
        watchdog = &wdt;
    };
};

/ {
    gpios {
		compatible = "gpio-keys";
		akdsleep: akdsleep {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
		};

        akdreset: akdreset {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		};
	
        imui: imui {
			gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
		};		
		
	};

    leds {
        compatible = "gpio-leds";

        led_red: led_red {
            gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
        };

        led_green: led_green {
            gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        akdsleep = &akdsleep;
        akdreset = &akdreset;
        spi2 = &spi2;
        imui = &imui;
    };
};